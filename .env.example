# 复制为 .env 并填入真实值；uv run --env-file .env 会自动加载。
# .env 已被 .gitignore 忽略，不会提交。

# 百炼（DashScope）—— 文本/视觉 LLM 主候选
DASHSCOPE_API_KEY=

# 硅基流动（SiliconFlow）—— embedding / rerank 等
SF_API_KEY=
# SF_BASE_URL=https://api.siliconflow.cn/v1

# 可选覆盖（不设则用 config.yaml 里的默认模型）
# SF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct-128K
# SF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# SF_RERANK_MODEL=BAAI/bge-reranker-v2-m3